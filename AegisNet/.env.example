# ============================================================
# AegisNet Environment Variables
# ============================================================
# Copy this to .env and fill in actual values for local development
# Never commit .env with real secrets

# Database
DATABASE_URL=postgresql://aegisnet:aegisnet_password@localhost:5432/aegisnet
# For Docker Compose:
# DATABASE_URL=postgresql://aegisnet:aegisnet_password@postgres:5432/aegisnet

# JWT / Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
API_TITLE=AegisNet API
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173"]

# OpenAI Configuration
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=2000

# File Upload
MAX_UPLOAD_SIZE_MB=1000
UPLOAD_DIR=./data/uploads
ALLOWED_FILE_EXTENSIONS=pcap,pcapng

# Firewall Mode
# Options: mock, linux
FIREWALL_MODE=mock

# Firewall Connector
FIREWALL_CONNECTOR_URL=http://firewall-connector:8001
FIREWALL_CONNECTOR_SECRET=firewall-connector-secret-key

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Demo Mode
DEMO_MODE=false
DEMO_DATA_DIR=./data/samples

# Application Environment
ENVIRONMENT=development
# Options: development, staging, production
