# ==============================================================================
# AegisNet Production Docker Configuration
# ==============================================================================
# Copy this file to .env before running docker compose:
# Linux/macOS: cp .env.docker.example .env
# Windows: copy .env.docker.example .env

# --- Ports ---
FRONTEND_PORT=80
BACKEND_PORT=8001
POSTGRES_HOST_PORT=5433

# --- Database Credentials ---
POSTGRES_USER=aegisnet
POSTGRES_PASSWORD=replace_with_a_strong_database_password_1234
POSTGRES_DB=aegisnet

# --- Security ---
# Generate a strong random key: openssl rand -hex 32
JWT_SECRET=replace_with_a_64_character_random_hex_string_for_production_jwt

# --- AI Threat Copilot (OpenAI GPT-4o) ---
# Optional: If omitted, AegisNet automatically falls back to its built-in
# local heuristic MITRE ATT&CK Copilot engine.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# --- Environment ---
ENVIRONMENT=production
LOG_LEVEL=INFO
